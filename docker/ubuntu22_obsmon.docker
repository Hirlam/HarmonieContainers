#
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y

RUN apt-get install -y \
        automake \
        bash \
        bash-completion \
        gcc \
        g++ \
        git \
        libtool \
        make \
        wget \
        vim

RUN apt-get install -y \
        gpg

RUN wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | gpg --dearmor -o /usr/share/keyrings/r-project.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/r-project.gpg] https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/" | tee -a /etc/apt/sources.list.d/r-project.list

RUN apt-get update -y

RUN apt-get install -y \
        r-base

# curl
RUN apt-get install -y \
        curl \
        libcurl4-openssl-dev

# systemfonts
RUN apt-get install -y \
    libfontconfig1-dev \
    libfreetype6-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libpng-dev \
    libtiff-dev \
    libjpeg-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libnetcdf-dev \
    libsqlite3-dev \
    libudunits2-dev \
    libv8-dev

# Cairo
RUN apt-get install -y \
    libcairo2 \
    libcairo2-dev

# openssl
RUN apt-get install -y \
    libssl-dev

# Create user environment
RUN useradd --create-home obsmon

WORKDIR /home/obsmon
USER obsmon

ENV USER=obsmon

RUN mkdir /home/obsmon/.ssh
RUN chown obsmon:obsmon /home/obsmon/.ssh

# Authorize SSH Host
RUN mkdir -p /home/obsmon/.ssh
RUN chown obsmon:obsmon /home/obsmon/.ssh
RUN chmod 0700 /home/obsmon/.ssh
RUN getent hosts github.com || echo "DNS failed"

RUN ssh-keyscan -t ed25519 -p 443 ssh.github.com > /home/obsmon/.ssh/known_hosts

# Add the keys and set permissions
ARG SSH_KEY
RUN echo "$SSH_KEY" > /home/obsmon/.ssh/id_ed25519 && \
chmod 700 /home/obsmon/.ssh/id_ed25519

WORKDIR /home/obsmon
RUN git clone https://github.com/Hirlam/obsmon.git
WORKDIR /home/obsmon/obsmon
RUN ls -l
RUN ./install

CMD ["/bin/bash"]
